# BuildSprint Round 2 Environment Configuration Template
# Copy to .env and configure as needed.
# If no LLM credentials are provided, the backend operates seamlessly in heuristic mode.

# Application Environment (production, development, test)
APP_ENV=production

# LLM Configuration (Provider agnostic: openai, anthropic, google)
# Leave empty for pure heuristic mode (regex intent parser + extractive summarizer)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Security & Proxies
# Comma-separated list of trusted upstream proxy IPs for X-Forwarded-For resolution
TRUSTED_PROXIES=

# Testing (Honored ONLY when APP_ENV=test)
ALLOW_LOCALHOST_FOR_TESTS=false
