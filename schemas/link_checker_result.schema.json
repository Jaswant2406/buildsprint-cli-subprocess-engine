{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkCheckerResult",
  "type": "object",
  "required": ["site", "links", "stats"],
  "properties": {
    "site": {
      "type": "string",
      "format": "uri"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status"],
        "properties": {
          "url": { "type": "string" },
          "status_code": { "type": ["integer", "null"] },
          "status": {
            "type": "string",
            "enum": ["working", "broken", "error"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["checked", "working", "broken"],
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "working": { "type": "integer", "minimum": 0 },
        "broken": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
